# Brewfile — install everything with `brew bundle --file=Brewfile`
# Kept in sync with scripts/. Entries are added as each tool is set up.

# --- Terminal & multiplexer ---
cask "wezterm"
brew "tmux"

# --- Editor ---
brew "neovim"

# --- Common CLI deps used across the agentic toolchain ---
brew "git"
brew "gh"
brew "node"      # for npx-based tools (skills CLI, etc.)
brew "ripgrep"   # nvim/telescope + general search
brew "fd"        # fast find, used by many nvim setups
